{
  "name": "Merkn",
  "short_name": "Merkn",
  "description": "Notizen für Privat, Beruflich und Freelance",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F2F4F1",
  "theme_color": "#F2F4F1",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "audio/*",
            "image/*",
            ".m4a",
            ".mp3",
            ".wav",
            ".amr",
            ".3gp",
            ".ogg",
            ".opus"
          ]
        }
      ]
    }
  }
}